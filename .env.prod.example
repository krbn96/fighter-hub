# AWS Lightsail本番環境用。このファイルをコピーして .env.prod を作成し、実際の値を設定してください。
# .env.prod は .gitignore でGit管理対象外にしているため、実secretを直接ここへ書かないでください。
#
#   cp .env.prod.example .env.prod
#
# 起動コマンド(compose.prod.yaml側で.env.prodを明示的に指定する必要があります):
#   docker compose -f compose.prod.yaml --env-file .env.prod up -d --build

# 本番PostgreSQLの接続パスワード。postgresコンテナ(POSTGRES_PASSWORD)とBackend
# コンテナ(DB_PASSWORD)の両方で同じ値が使われます。十分に長いランダムな文字列を設定してください。
DB_PASSWORD=

# JWT署名用secret。Base64エンコードされた32byte(256bit)以上の値が必要です
# (HS256での署名に必要な鍵長の要件。不足していると起動時にエラーになります)。
# ローカルの.env用とは別の値を、本番専用に新しく生成してください。
# 生成例(opensslが利用可能な環境):
#   openssl rand -base64 32
JWT_SECRET=

# Discordアカウント連携(OAuth)用。Discord Developer PortalでApplicationを作成して取得してください
# (https://discord.com/developers/applications)。
# Client Secretは絶対にリポジトリへ書かないでください。
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord Developer Portal側の「Redirects」に登録するcallback URLと完全に一致させてください。
# Lightsailの実際の公開IPアドレスまたはドメインを使用してください
# (今回はHTTPS対応を行わないため、一時的にhttp://のままで構いません。
#  HTTPS対応時にこの値とDiscord Developer Portal側の設定を合わせて更新してください)。
# 例: http://<Lightsailの公開IPまたはドメイン>/api/oauth/discord/callback
DISCORD_REDIRECT_URI=

# OAuth state(Discordアカウント連携時の一時トークン)の署名用secret。
# JWT_SECRETとは別の値を設定してください(ログイン用JWTとOAuth stateを分離するため)。
# Base64エンコードされた32byte(256bit)以上の値が必要です。生成例は上記JWT_SECRETと同様です。
OAUTH_STATE_SECRET=

# OAuth callback完了後にリダイレクトするFrontendのオリジン。
# Lightsailの実際の公開IPアドレスまたはドメインを使用してください(例: http://<公開IPまたはドメイン>)。
# 末尾にパスを付けないこと(DiscordOAuthService側で/mypage等のpathを付加するため)。
FRONTEND_BASE_URL=
